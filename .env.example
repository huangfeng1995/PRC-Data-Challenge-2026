# .env.example — 配置模板(不含真实密钥)
# 复制为 .env 后填入真实值, .env 已被 .gitignore 排除
#
# ⚠️ 这个文件可入库, .env 不可入库.
# 云端 Agent 需要全量数据时, 把 .env 放到项目根目录,
# 然后运行: python3 scripts/download_data.py

# OSN (OpenSky Network) MinIO 凭据
# 在 https://opensky-network.org 申请 team bucket 后从 dashboard 生成
OSN_ACCESS_KEY="your-access-key-here"
OSN_SECRET_KEY="your-secret-key-here"

# 可选: 自定义 endpoint (默认 s3.opensky-network.org)
OSN_ENDPOINT="https://s3.opensky-network.org"